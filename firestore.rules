rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{document} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2';
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2';
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth.uid == 'Bi68Kqd5jBPun5bIgXo0u5yTNmj2';
    }
  }
}
